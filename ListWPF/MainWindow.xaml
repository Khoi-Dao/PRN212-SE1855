<Window x:Class="ListWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ListWPF"
        mc:Ignorable="d"
        Title="Thao tác trên List" Height="360" Width="282">
    <Grid>
        <TextBox x:Name="txtGiaTri" HorizontalAlignment="Left" Height="23" Margin="17,10,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="98" />
        <Button x:Name="btnThem" Content="Thêm vào List" HorizontalAlignment="Left" Margin="127,13,0,0" VerticalAlignment="Top" Width="115" RenderTransformOrigin="0.341,0.611" Click="btnThem_Click"/>
        <ListBox x:Name="lstDuLieu"  SelectionMode="Multiple" HorizontalAlignment="Left" VerticalAlignment="Top" Height="275" Width="100" Margin="15,38,0,0"/>
        <Button x:Name="btnSapXepTang" Content="Sấp xếp tăng" HorizontalAlignment="Left" Margin="127,143,0,0" VerticalAlignment="Top" Height="20" Click="btnSapXepTang_Click" Width="115"/>
        <Button x:Name="btnSapXepGiam" Content="Sấp xếp giảm" HorizontalAlignment="Left" Margin="127,180,0,0" VerticalAlignment="Top" Height="20" Click="btnSapXepGiam_Click" Width="115"/>
        <Button x:Name="btnXoa1PhanTu" Content="Xóa 1 phần tử" HorizontalAlignment="Left" Margin="127,220,0,0" VerticalAlignment="Top" Width="115" Height="20" Click="btnXoa1PhanTu_Click"/>
        <Button x:Name="btnXoaNhieuPhanTu" Content="Xóa nhiều phần tử" HorizontalAlignment="Left" Margin="127,256,0,0" VerticalAlignment="Top" Width="115" Height="20" Click="btnXoaNhieuPhanTu_Click"/>
        <Button x:Name="btnXoaToanBoPhanTu" Content="Xóa toàn bộ phần tử" HorizontalAlignment="Left" Margin="127,293,0,0" VerticalAlignment="Top" Width="115" Height="20" Click="btnXoaToanBoPhanTu_Click"/>
        <Label Content="Gía trị" HorizontalAlignment="Left" Margin="127,45,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="txtGiaTriChen" HorizontalAlignment="Left" Margin="176,48,0,0" TextWrapping="Wrap"  VerticalAlignment="Top" Width="66" Height="23"/>
        <Label Content="Vị Trí" HorizontalAlignment="Left" Margin="127,73,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="txtViTriChen" HorizontalAlignment="Left" Margin="176,76,0,0" TextWrapping="Wrap"  VerticalAlignment="Top" Width="66" Height="23" RenderTransformOrigin="0.48,1.71"/>
        <Button x:Name="btnChen" Content="Chèn" HorizontalAlignment="Left" Margin="176,111,0,0" VerticalAlignment="Top" Width="66" Height="20" Click="btnChen_Click"/>





    </Grid>
</Window>
